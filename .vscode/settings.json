// =================================================================================================
// VS Code Workspace Settings for Morpha
//
// Project-specific preferences for editor behavior and development tooling.
// =================================================================================================
{
  // --- Editor Layout and Behavior ----------------------------------------------------------------
  "workbench.editor.closeEmptyGroups": false,
  "workbench.editor.openSideBySideDirection": "right",
  "workbench.editor.openPositioning": "last",
  "editor.lineNumbers": "on",
  "editor.rulers": [100],
  "editor.wordWrap": "off",

  // --- File Explorer and Exclusions --------------------------------------------------------------
  "files.exclude": {
    "**/.git": false,
    "**/.DS_Store": true,
    "**/.pytest_cache": true,
    "**/__pycache__": true,
    "**/.mypy_cache": true
  },
  "search.exclude": {
    "**/.git": true,
    "**/.DS_Store": true,
    "**/.pytest_cache": true,
    "**/__pycache__": true,
    "**/.mypy_cache": true,
    "**/docs/_build": true,
    "archive": true
  },

  // --- Environment and Terminal ------------------------------------------------------------------
  "python.defaultInterpreterPath": "${userHome}/miniconda3/envs/morpha/bin/python",
  "python.terminal.activateEnvironment": true,

  // --- Spell Checking ----------------------------------------------------------------------------
  "cSpell.enabled": true,
  "cSpell.customDictionaries": {
    "project": {
      "name": "project",
      "path": "${workspaceFolder}/config/dictionaries/project.txt"
    },
    "python": {
      "name": "python",
      "path": "${workspaceFolder}/config/dictionaries/python.txt"
    },
    "tools": {
      "name": "tools",
      "path": "${workspaceFolder}/config/dictionaries/tools.txt"
    }
  },

  // --- Formatting --------------------------------------------------------------------------------
  "rewrap.wrappingColumn": 100,
  "rewrap.wholeComment": false,
  "rewrap.autoWrap.enabled": true,
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.formatOnSave": true
  },
  "black-formatter.args": ["--config", "${workspaceFolder}/config/tools/black.toml"],

  // --- Linting -----------------------------------------------------------------------------------
  "pylint.args": ["--rcfile=${workspaceFolder}/config/tools/pylintrc.ini"],
  "python.analysis.typeCheckingMode": "strict",

  // --- Static Type Checking ----------------------------------------------------------------------
  "mypy-type-checker.args": ["--config-file=${workspaceFolder}/config/tools/mypy.ini"],
  "mypy-type-checker.ignorePatterns": [
    "**/config/**",
    "**/conf.py",
    "**/*.ipynb"
  ],

  // --- Documentation -----------------------------------------------------------------------------
  "esbonio.server.enabled": true,
  "esbonio.server.enabledInPyFiles": true,
  "esbonio.sphinx.confDir": "docs",
  "esbonio.sphinx.srcDir": "docs",
  "esbonio.sphinx.builderName": "html",

  // --- Testing -----------------------------------------------------------------------------------
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": ["tests"],

  // --- Adaptive Language Assistance --------------------------------------------------------------
  "github.copilot.enable": {
    "*": true
  },
}
